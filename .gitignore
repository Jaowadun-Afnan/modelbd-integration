# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
venv/
env/
.venv/

# IDE folders
.vscode/
.idea/

# OS junk
.DS_Store
Thumbs.db

# Log files (ignore runtime logs, keep folder structure)
logs/*.log
!logs/.gitkeep

# ============================================================
# RAW DATA FILES - TRACK THEM (do NOT ignore)
# Your raw CSV, Excel, and PDF files are ESSENTIAL for the project.
# They should be uploaded to raw_data/original/ and tracked.
# ============================================================

# ============================================================
# EXTRACTED OUTPUT (generated by Phase 3)
# Ignore the extracted CSV files, keep the folder structure
# ============================================================
#raw_data/extracted/csv/*.csv
#!raw_data/extracted/csv/.gitkeep

#raw_data/extracted/pdf_tables/*.csv
#!raw_data/extracted/pdf_tables/.gitkeep

# ============================================================
# STAGING / CLEAN OUTPUT (generated by Phase 4)
# Ignore the clean CSV files, keep the folder structure
# ============================================================
#staging/clean/*.csv
#!staging/clean/.gitkeep

# ============================================================
# NOTE: raw_data/original/ is intentionally NOT ignored
# All raw CSV, Excel, and PDF files should be tracked.
# They are the source of truth for the ETL pipeline.
# ============================================================
